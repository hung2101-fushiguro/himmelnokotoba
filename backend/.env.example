# API key lấy từ console.groq.com (bắt buộc để gọi Groq)
GROQ_API_KEY=your_key_here

# API key lấy từ Google AI Studio (bắt buộc để gọi Gemini)
GEMINI_API_KEY=your_key_here

# Domain của Frontend, dùng để cấu hình CORS (vd: https://himmel-no-kotoba.vercel.app)
ALLOWED_ORIGIN=your_frontend_domain_here